{
  "name": "semantic-assert-monorepo",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run build typecheck && tsc --noEmit",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "check:packages": "pnpm build && node scripts/check-packages.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "pnpm check && pnpm check:packages && changeset publish",
    "test:integration": "pnpm build && playwright test",
    "examples:core": "pnpm build && pnpm --filter semantic-assert-examples test",
    "examples:playwright": "pnpm build && pnpm --filter semantic-assert-examples test:playwright"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@playwright/test": "1.58.1",
    "@types/node": "^22.15.17",
    "prettier": "^3.5.1",
    "turbo": "^2.9.14",
    "typescript": "5.7.3"
  }
}

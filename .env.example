# Copy to .env (gitignored). No key is needed for the default scripted examples.

# Direct TypeSafe access: EXAMPLE_PROVIDER=typesafe and the TypeSafe integration smoke test.
TYPESAFE_API_KEY=

# Vercel AI Gateway: EXAMPLE_PROVIDER=ai-sdk, `pnpm examples:gateway`, and the Gateway smoke test.
AI_GATEWAY_API_KEY=

# OpenAI Decisions API: EXAMPLE_PROVIDER=openai and the OpenAI smoke test.
OPENAI_API_KEY=

# Optional: your current Jev input-token rate, so the TypeSafe provider estimates cost.
# TYPESAFE_USD_PER_MTOK_INPUT=0.042

# Optional: your current OpenAI Decisions input-token rate, for the same estimate.
# OPENAI_DECISIONS_USD_PER_MTOK_INPUT=0.10

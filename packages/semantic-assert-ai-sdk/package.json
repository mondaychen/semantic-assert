{
  "name": "semantic-assert-ai-sdk",
  "version": "0.2.0",
  "type": "module",
  "description": "Vercel AI SDK evaluation provider for semantic-assert, with Jev via AI Gateway.",
  "keywords": [
    "semantic-assert",
    "ai-sdk",
    "vercel",
    "ai-gateway",
    "provider"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mondaychen/semantic-assert.git",
    "directory": "packages/semantic-assert-ai-sdk"
  },
  "homepage": "https://github.com/mondaychen/semantic-assert/tree/main/packages/semantic-assert-ai-sdk#readme",
  "bugs": {
    "url": "https://github.com/mondaychen/semantic-assert/issues"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup && node scripts/fix-cjs-types.mjs",
    "lint": "oxlint --type-aware --deny-warnings .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@types/json-schema": "^7.0.15",
    "semantic-assert": "workspace:^"
  },
  "peerDependencies": {
    "ai": ">=7.0.107 <8"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "oxlint": "1.50.0",
    "oxlint-tsgolint": "^0.17.3",
    "tsup": "^8.5.0",
    "typescript": "5.7.3",
    "vitest": "^4.1.11",
    "ai": "7.0.107"
  },
  "module": "./dist/index.js",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}

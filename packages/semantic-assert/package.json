{
  "name": "semantic-assert",
  "version": "0.2.0",
  "type": "module",
  "description": "Provider-agnostic core for semantic assertions: typed yes/no and multiple-choice questions over JSON state, a polling judge with thresholds, and usage metrics. Providers (TypeSafe Jev, LLMs) plug in as separate packages.",
  "keywords": [
    "semantic",
    "assertion",
    "llm",
    "judge",
    "testing",
    "typesafe",
    "jev"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mondaychen/semantic-assert.git",
    "directory": "packages/semantic-assert"
  },
  "homepage": "https://github.com/mondaychen/semantic-assert/tree/main/packages/semantic-assert#readme",
  "bugs": {
    "url": "https://github.com/mondaychen/semantic-assert/issues"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "oxlint --type-aware --deny-warnings .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vitest": "^4.1.11",
    "@types/node": "^22.15.17",
    "tsup": "^8.5.0",
    "oxlint": "1.50.0",
    "oxlint-tsgolint": "^0.17.3"
  },
  "module": "./dist/index.js",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
